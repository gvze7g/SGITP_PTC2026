# =========================================================
#  SGITP_BACKEND - variables de entorno
#  Copia este archivo como .env y llena los valores.
#
#  OJO: estos son los nombres que REALMENTE lee src/config.js.
#  El README principal listaba otros nombres (MONGODB_URI,
#  SERVER_PORT, JWT_SECRET, EMAIL_USER...) que el codigo ignora.
# =========================================================

# ---------- Servidor ----------
PORT=4000

# ---------- Base de datos ----------
# Cadena de conexion de MongoDB Atlas o local
DB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/peques

# Opcional: solo si la red del colegio bloquea el DNS de Atlas
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------- Sesiones (JWT) ----------
# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=

# ---------- Correo (recuperacion de contrasena) ----------
# Usa una "contrasena de aplicacion" de Gmail, NO tu contrasena normal
USER_EMAIL=
USER_PASSWORD=

# ---------- Cloudinary (subida de imagenes) ----------
# Los 3 valores estan en el Dashboard de cloudinary.com
# Si falta cualquiera, la subida de imagenes queda deshabilitada
# y el backend lo avisa en consola al arrancar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Wompi (pagos) ----------
GRANT_TYPE=client_credentials
AUDIENCE=
CLIENT_ID=
CLIENT_SECRET=

# ---------- Login con Google ----------
# Google entrega un Client ID DISTINTO por plataforma.
# El backend acepta cualquiera de los que pongas aqui.
# Ver GUIA_LOGIN_SOCIAL.md para sacarlos paso a paso.

# Obligatorio: el que usa la web (tipo "Aplicacion web")
GOOGLE_CLIENT_ID=

# Solo si vas a usar el login desde la app movil
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
# El de tipo "Aplicacion web" que usa Expo Go durante el desarrollo
GOOGLE_CLIENT_ID_EXPO=

# ---------- Login con Apple ----------
# Lista separada por comas. Normalmente son dos:
#   1. El Services ID que creas para la web   -> com.peques.web
#   2. El Bundle ID de la app movil            -> com.peques.movil
# Requiere cuenta de Apple Developer de pago (99 USD/ano).
APPLE_CLIENT_IDS=

# ---------- CORS y cookies ----------
# Origenes extra permitidos, separados por coma (para produccion).
# localhost y las IPs de red local (192.168.x, 10.x) ya estan permitidos.
# CORS_ORIGINS=https://peques.com,https://admin.peques.com

# En local dejalo asi. En produccion con HTTPS:
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
