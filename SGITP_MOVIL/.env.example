# =========================================================
#  SGITP_MOVIL - variables de entorno
#  Copia este archivo como .env (en la raiz de SGITP_MOVIL).
#  En Expo, TODA variable que use la app debe empezar con EXPO_PUBLIC_
#  Despues de cambiar este archivo hay que reiniciar: npx expo start -c
# =========================================================

# URL del backend. En el celular NO sirve localhost: hay que poner la IP
# de tu computadora en la red WiFi (la misma que muestra Expo al arrancar).
# Windows: ipconfig    |    Mac/Linux: ifconfig
EXPO_PUBLIC_API_URL=http://192.168.0.20:4000/api

# ---------- Login con Google ----------
# Client IDs de Google Cloud Console (uno por plataforma).
# Todos deben estar tambien en el .env del backend.

# Tipo "Aplicacion web" - lo usa Expo Go mientras desarrollas
EXPO_PUBLIC_GOOGLE_CLIENT_ID_EXPO=

# Tipo "iOS" - requiere el Bundle ID de app.json
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# Tipo "Android" - requiere el Package name y la huella SHA-1
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# Nota: Apple Sign In no necesita variables aqui. Se configura con el
# Bundle ID en app.json y solo funciona en dispositivos iOS reales
# (o simulador iOS 13+), nunca en Android.
