{
  "expo": {
    "name": "Peques",
    "slug": "SGITP_MOVIL",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F4"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F4"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gvz.e7g.peques"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F4"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4b2d1daa-1e8e-49ac-91a9-9a93b8f8c67d"
      }
    }
  }
}
