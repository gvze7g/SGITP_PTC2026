# =========================================================
#  SGITP_WEB - variables de entorno
#  Copia este archivo como .env (en la raiz de SGITP_WEB).
#  En Vite, TODA variable que use el navegador debe empezar con VITE_
# =========================================================

# URL del backend (incluye /api al final)
VITE_API_URL=http://localhost:4000/api

# ---------- Login con Google ----------
# Client ID de tipo "Aplicacion web" de Google Cloud Console.
# Debe ser EL MISMO valor que GOOGLE_CLIENT_ID en el .env del backend.
# Sin esto el boton de Google aparece deshabilitado.
VITE_GOOGLE_CLIENT_ID=

# ---------- Login con Apple ----------
# Services ID creado en developer.apple.com (ej: com.peques.web).
# Debe estar incluido en APPLE_CLIENT_IDS del .env del backend.
# Sin esto el boton de Apple aparece deshabilitado.
VITE_APPLE_CLIENT_ID=

# URL de retorno registrada en Apple. Tiene que ser HTTPS y coincidir
# EXACTAMENTE con la que configuraste en el Services ID.
# En desarrollo se puede usar un tunel (ngrok, cloudflared).
VITE_APPLE_REDIRECT_URI=https://localhost:5173/login
